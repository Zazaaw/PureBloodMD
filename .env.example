# Public (safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only, used by `npm run db:seed`. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Site URL for email confirmation links
# Production URL: Supabase Site URL and allowed email redirect (npm run supabase:push -- email)
SITE_URL_PRODUCTION=https://www.purebloodmd.com
# Other deployed origins that may also receive auth links (comma separated)
SITE_URL_EXTRA=https://purebloodmd.com,https://purebloodmd.p441z.my.id,https://pureblood.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3333

# CAPTCHA (Cloudflare Turnstile). Test keys shown; replace for production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
SUPABASE_AUTH_CAPTCHA=off

# Optional: lets `npm run supabase:push` run migrations and set the email template for you.
# Create at supabase.com/dashboard/account/tokens. Server-only, never NEXT_PUBLIC_.
SUPABASE_ACCESS_TOKEN=

# Custom SMTP (needed for the branded email template on Supabase's free plan).
# Gmail: smtp.gmail.com, 587, your address, a 16-char App Password (Google Account > Security > App passwords).
# Resend: smtp.resend.com, 587, user "resend", API key as password, from an address on your verified domain.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SENDER_NAME=PureBloodMD
